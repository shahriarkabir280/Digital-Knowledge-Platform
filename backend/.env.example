# Backend environment template
BACKEND_PORT=3000

# Supabase Configuration (REQUIRED)
# Get DATABASE_URL from https://supabase.com/dashboard -> Project Settings -> Database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres.ccoktdvawencnyvwetqw:DegitalKnowledge@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=7d

# File Upload Configuration
# Maximum upload size in MB (default: 500)
UPLOAD_MAX_SIZE_MB=500

# Base directory for file uploads (relative to backend root)
# Default: ./uploads
# Change to absolute path for production: /var/uploads or /mnt/uploads
UPLOAD_DIR=./uploads

# Allowed file extensions (comma-separated)
# Default: pdf,docx,pptx,mp3,mp4,jpg,jpeg,png
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,pptx,mp3,mp4,jpg,jpeg,png

# Enable strict MIME type validation (default: true)
# Set to false only if clients send incorrect MIME types
UPLOAD_STRICT_MIME_VALIDATION=true

# Cleanup old temporary files (hours, default: 24)
UPLOAD_TEMP_CLEANUP_HOURS=24

# Python Microservice for Metadata Extraction
# Default: http://python-service:8000 (in Docker) or http://localhost:8000 (local dev)
# PYTHON_SERVICE_URL=http://localhost:8000

# Root environment template for Digital Knowledge Platform

# App
APP_NAME=Digital-Knowledge-Platform
APP_ENV=development
APP_PORT=3000

# Frontend
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# Backend
BACKEND_PORT=3000
BACKEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dkp
DB_USER=postgres
DB_PASSWORD=postgres

# Cache / Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=30m

# Search
SEARCH_ENGINE_URL=http://localhost:9200

# Mail (optional in local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

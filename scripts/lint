#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

BACKEND_DIR="$REPO_ROOT/backend"
FRONTEND_DIR="$REPO_ROOT/frontend"

echo "Running backend lint (if configured)..."
npm --prefix "$BACKEND_DIR" run --if-present lint

echo "Running frontend lint (if configured)..."
npm --prefix "$FRONTEND_DIR" run --if-present lint

echo "Lint script finished."

# Backend environment template
# Copy this file to .env and fill in real values. Never commit .env.
BACKEND_PORT=3000

# ─── Supabase Database ────────────────────────────────────────────────────────
# Get from: Supabase Dashboard -> Project Settings -> Database
# Session-mode pooler URL (port 5432, no pgbouncer flag) — works with Knex
DATABASE_URL=postgresql://<db-user>:<db-password>@<supabase-pooler-host>:5432/postgres

# ─── Supabase Storage / Auth ──────────────────────────────────────────────────
# Get from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
# Full admin access — server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ─── File Upload ──────────────────────────────────────────────────────────────
# Maximum upload size in MB (default: 500)
UPLOAD_MAX_SIZE_MB=500

# Allowed file extensions (comma-separated)
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,pptx,mp3,mp4,jpg,jpeg,png

# Enable strict MIME type validation (default: true)
UPLOAD_STRICT_MIME_VALIDATION=true

# ─── Python Microservice for Metadata Extraction ──────────────────────────────
# Default: http://python-service:8000 (in Docker) or http://localhost:8000 (local dev)
PYTHON_SERVICE_URL=http://localhost:8000

# ─── Email Notifications (optional) ───────────────────────────────────────────
# Set EMAIL_PROVIDER=smtp to enable email notifications
# Leave blank to use console logging only
EMAIL_PROVIDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Digital Knowledge Platform Library <no-reply@library.local>"
